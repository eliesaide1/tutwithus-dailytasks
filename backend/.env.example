# MongoDB connection string. Local default uses the MongoDB Windows service on 27017.
MONGODB_URI=mongodb://127.0.0.1:27017/tutwithus_portal
# Long random secret for signing session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me
PORT=4000
# Frontend origin(s) when hosted separately from the API (comma separated)
APP_ORIGINS=http://localhost:5173

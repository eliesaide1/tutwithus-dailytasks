# MongoDB connection string. Local default uses the MongoDB Windows service on 27017.
MONGODB_URI=mongodb://127.0.0.1:27017/tutwithus_portal
# Long random secret for signing session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me
PORT=4000
# Frontend origin(s) when hosted separately from the API (comma separated)
APP_ORIGINS=http://localhost:5173
# Where the portal is reachable. Used to build the links inside notification emails,
# so set it to the real address in production or people get localhost links.
APP_URL=http://localhost:5173

# Approval emails — Titan business email (Hostinger). Optional: leave SMTP_USER/SMTP_PASS
# unset and nothing is emailed while the rest of the portal works normally.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@tutwithus.com
# The mailbox password, or an app password if the account has one.
SMTP_PASS=
# What recipients see in "From" (defaults to SMTP_USER)
SMTP_FROM=TutWithUs Portal <info@tutwithus.com>

# Task attachments — DigitalOcean Spaces (S3 compatible). Optional: leave unset and the
# attachment endpoints answer 503 while the rest of the portal works normally.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1
# Derived from the region when omitted: https://<region>.digitaloceanspaces.com
SPACES_ENDPOINT=
# Largest single upload, in MB (default 25)
MAX_ATTACHMENT_MB=25
